{
  "name": "polygon-paradise-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --tsconfig tsconfig.worker.json worker/index.ts",
    "build": "prisma generate && next build && npm run build:worker",
    "build:web": "next build",
    "build:webpack": "next build --webpack",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -H 0.0.0.0 -p 3000 --keepAliveTimeout 100000",
    "start:worker": "node dist/worker.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "demo:seed": "tsx scripts/make-demo-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.2.4",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "dotenv": "18.0.3",
    "encoding-sniffer": "0.2.1",
    "htmlparser2": "10.1.0",
    "i18n-iso-countries": "7.14.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "temporal-polyfill": "1.0.5",
    "tldts": "7.4.14",
    "undici": "7.30.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.0": true
  }
}
