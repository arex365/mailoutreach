      "pages": {
        "/robots.txt": { "status": 200, "contentType": "text/plain", "body": "User-agent: *\nDisallow:\n" }
      },
      "redirects": {
        "/": { "to": "https://www.redirect-www.example/", "status": 301 }
      }
    }
  }
}
